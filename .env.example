# Origen canónico real, sin barra final. Dejalo vacío en previews y en local.
# Producción, cuando el dominio ya responda: https://festejito.com.ar
PUBLIC_SITE_URL=

# Solo "true" cuando PUBLIC_SITE_URL sea el dominio definitivo.
# Cualquier otro valor genera el sitio con noindex.
PUBLIC_ALLOW_INDEXING=false

# Correo real de quien opera el sitio. Vacío = la página de contacto explica que todavía no está habilitado.
PUBLIC_CONTACT_EMAIL=

# Identificadores reales de AdSense. No inventar valores.
# Aunque estén completos, los anuncios siguen apagados hasta implementar el consentimiento que corresponda.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# Identificador real de analítica, si más adelante se usa.
# Sigue apagada: esta versión no tiene un flujo de consentimiento.
PUBLIC_ANALYTICS_ID=
