---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Artwork from '../components/art/Artwork.astro';
import QuickStart from '../components/planner/QuickStart';
import { site } from '../config/site';
import { CategoryIcon } from '../components/directory/CategoryIcon';
import { publishedProviders } from '../data/providers/records';
import { categoryLabel, providerPath } from '../data/providers/selectors';

const title = 'Organizá el cumpleaños infantil | Festejito';
const description = 'Calculá comida y bebida, ordená el presupuesto y llevá una lista de lo que falta para un cumpleaños infantil en Argentina.';
const website = site.origin
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: site.brand, url: site.origin, inLanguage: 'es-AR' }
  : null;
const providers = publishedProviders().sort((a, b) => a.name.localeCompare(b.name, 'es'));
---

<Base title={title} description={description} path="/">
  <JsonLd slot="head" data={website} />
  <div class="container home">
    <section class="hero">
      <div>
        <p class="eyebrow">Tu próximo cumple, más simple</p>
        <h1>Que el cumple sea una fiesta. Organizarlo también.</h1>
        <p class="lede">Calculá comida y bebida, ordená el presupuesto y llevá una lista de todo lo que falta.</p>
        <div class="actions">
          <a class="button button-primary" href="/organizador/">Empezar a organizar</a>
          <a class="text-link" href="/calculadora-comida-cumpleanos/">Calcular comida y bebida</a>
        </div>
        <p class="trust">Gratis y sin crear una cuenta.</p>
      </div>
      <div class="hero-art">
        <Artwork name="hero" class="hero-scene" />
        <p class="paper-label">Todo en su lugar</p>
      </div>
    </section>

    <section class="quick-strip" aria-label="Cantidades del festejo">
      <QuickStart client:load />
    </section>

    <section class="section">
      <h2>Todo lo que necesitás, conectado.</h2>
      <div class="tool-board">
        <a class="tool-tile food" href="/calculadora-comida-cumpleanos/">
          <Artwork name="cake" />
          <div>
            <h3>Comida y bebida</h3>
            <p>Estimá sándwiches, pizza, torta y envases. Cada supuesto se puede corregir.</p>
            <span>Calcular cantidades</span>
          </div>
        </a>
        <a class="tool-tile budget" href="/presupuesto-cumpleanos/">
          <Artwork name="receipt" />
          <div>
            <h3>Presupuesto</h3>
            <p>Cargá tus precios en pesos y compará hasta tres alternativas del mismo servicio.</p>
            <span>Armar el presupuesto</span>
          </div>
        </a>
        <a class="tool-tile tasks" href="/checklist-cumpleanos/">
          <Artwork name="list" />
          <div>
            <h3>Checklist</h3>
            <p>Tareas desde cuatro semanas antes hasta el día del festejo.</p>
            <span>Ver la checklist</span>
          </div>
        </a>
        <a class="tool-tile shop" href="/lista-compras-cumpleanos/">
          <Artwork name="bag" />
          <div>
            <h3>Compras</h3>
            <p>La lista sale del cálculo y no duplica ítems cuando la actualizás.</p>
            <span>Abrir la lista</span>
          </div>
        </a>
      </div>
    </section>

    <section class="section">
      <h2>Tres pasos, un solo plan</h2>
      <ol class="sequence">
        <li>
          <Artwork name="drinks" />
          <h3>Contá quiénes vienen</h3>
          <p>Lugar, duración, chicos y adultos. Sin nombre del niño ni datos de los invitados.</p>
        </li>
        <li>
          <Artwork name="receipt" />
          <h3>Ajustá cantidades y presupuesto</h3>
          <p>Las cantidades son un punto de partida. Los importes los cargás vos, en pesos.</p>
        </li>
        <li>
          <Artwork name="list" />
          <h3>Llevá el control hasta el gran día</h3>
          <p>Tareas y compras en un mismo lugar, para tachar o imprimir.</p>
        </li>
      </ol>
    </section>

    <section class="section">
      <h2>Guías para decidir antes de comprar</h2>
      <div class="guide-feature">
        <article class="guide-row">
          <Artwork name="list" />
          <div>
            <h3>Cómo organizar un cumpleaños infantil</h3>
            <p>Del presupuesto inicial al día del cumple, sin transformar el festejo en un proyecto eterno.</p>
            <a href="/guias/como-organizar-un-cumpleanos-infantil/">Leer la guía</a>
          </div>
        </article>
        <article class="guide-row">
          <Artwork name="cake" />
          <div>
            <h3>Cómo calcular la comida para un cumpleaños</h3>
            <p>Cómo leer la estimación y qué cambiar si el menú no es solo sándwiches.</p>
            <a href="/guias/como-calcular-comida-para-un-cumpleanos/">Leer la guía</a>
          </div>
        </article>
        <article class="guide-row">
          <Artwork name="drinks" />
          <div>
            <h3>Cumpleaños en casa o en salón</h3>
            <p>Qué preguntar para comparar dos propuestas que no incluyen lo mismo.</p>
            <a href="/guias/cumpleanos-en-casa-o-en-salon/">Leer la guía</a>
          </div>
        </article>
      </div>
      <p><a href="/guias/">Ver todas las guías</a></p>
    </section>

    {providers.length > 0 && (
      <section class="provider-band">
        <div>
          <h2>Proveedores en Córdoba Capital</h2>
          <p>Un directorio corto, armado con datos publicados en sitios oficiales. Es la ciudad de Córdoba, no toda la provincia, y no es un ranking.</p>
          <a class="button button-secondary" href="/cumpleanos-infantiles-cordoba/">Ver el directorio</a>
        </div>
        <ul class="provider-names">
          {providers.map((provider) => (
            <li>
              <a href={providerPath(provider)}>
                <CategoryIcon category={provider.categories[0]} size="sm" />
                <span>{provider.name}</span>
                <span>{categoryLabel(provider.categories[0])}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="section faq">
      <h2>Preguntas frecuentes</h2>
      <details>
        <summary>¿El plan se sincroniza entre el celular y la computadora?</summary>
        <p>No. Queda guardado en el navegador donde lo armaste, así que conviene usar siempre el mismo. La lista de compras se puede copiar o imprimir para llevarla a mano.</p>
      </details>
      <details>
        <summary>¿Las cantidades alcanzan seguro?</summary>
        <p>No. Son supuestos editables para planificar la compra. El apetito, el clima y el menú los cambian.</p>
      </details>
      <details>
        <summary>¿Puedo cargar los precios de mi ciudad?</summary>
        <p>Sí. El presupuesto empieza vacío a propósito: no inventamos precios de Argentina.</p>
      </details>
    </section>

    <section class="band">
      <h2>Empezá con los que ya sabés que vienen.</h2>
      <p>El resto del plan se acomoda en el mismo lugar: comida, plata y lo que falta comprar.</p>
      <a class="button button-secondary" href="/organizador/">Empezar a organizar</a>
    </section>
  </div>
</Base>
