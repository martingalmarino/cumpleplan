---
import Base from '../../layouts/Base.astro';
import DirectoryBrowser from '../../components/directory/DirectoryBrowser';
import DirectoryIntro from '../../components/directory/DirectoryIntro.astro';
import DirectoryMethodology from '../../components/directory/DirectoryMethodology.astro';
import { publishedProviders } from '../../data/providers/records';
import { site } from '../../config/site';

const providers = publishedProviders();
const empty = providers.length === 0;
const latestReview = empty ? null : providers.map((provider) => provider.verifiedAt).sort().at(-1)!;
const title = 'Cumpleaños infantiles en Córdoba Capital: salones, tortas y decoración';
const description = empty
  ? 'El directorio de proveedores de Córdoba Capital todavía no tiene fichas publicadas.'
  : 'Salones, tortas y decoración para cumpleaños infantiles en Córdoba Capital, con datos tomados de sus sitios oficiales. No es un ranking ni cubre toda la provincia.';
---

<Base title={title} description={description} path="/cumpleanos-infantiles-cordoba/" noindex={empty || !site.allowIndexing}>
  <div class="container directory-page">
    <DirectoryIntro empty={empty} />
    {!empty && (
      <>
        <script is:inline>
          (function () {
            var params = new URLSearchParams(window.location.search);
            if (!params.get('q') && !params.get('rubro') && params.get('whatsapp') !== '1') return;
            var root = document.documentElement;
            root.classList.add('directory-filtering');
            window.setTimeout(function () { root.classList.remove('directory-filtering'); }, 2500);
          })();
        </script>
        <DirectoryBrowser client:load providers={providers} />
        <DirectoryMethodology latestReview={latestReview!} />
      </>
    )}
  </div>
</Base>
