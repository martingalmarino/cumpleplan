---
import Base from '../../../../../layouts/Base.astro';
import JsonLd from '../../../../../components/seo/JsonLd.astro';
import DirectoryPage from '../../../../../components/directory/DirectoryPage.astro';
import { publishedProviders, type ProviderCategory } from '../../../../../data/providers/records';
import { filterByLocation } from '../../../../../data/providers/groups';
import { provinceSlug, citySlug, categorySlug, isIndexable, directoryProvincePath, directoryProvinceCityPath, directoryProvinceCityRubroPath } from '../../../../../data/providers/routes';
import { categoryLabel } from '../../../../../data/providers/selectors';
import { absoluteUrl, site } from '../../../../../config/site';

export function getStaticPaths() {
  const providers = publishedProviders();
  const routes: Array<{ params: { provincia: string; ciudad: string; rubro: string }; props: { province: string; city: string; category: ProviderCategory } }> = [];
  
  // Agrupar por provincia > ciudad > categoría
  const provinces = [...new Set(providers.map((p) => p.province))];
  
  for (const province of provinces) {
    const provinceProviders = filterByLocation(providers, { province });
    const cities = [...new Set(provinceProviders.map((p) => p.city))];
    
    for (const city of cities) {
      const cityProviders = filterByLocation(provinceProviders, { city });
      
      // Para cada categoría en esta ciudad
      const categories = [...new Set(cityProviders.flatMap((p) => p.categories))];
      for (const category of categories) {
        const categoryProviders = filterByLocation(cityProviders, { category });
        const count = categoryProviders.length;
        
        if (isIndexable(count)) {
          routes.push({
            params: { 
              provincia: provinceSlug(province), 
              ciudad: citySlug(city), 
              rubro: categorySlug(category) 
            },
            props: { province, city, category },
          });
        }
      }
    }
  }
  
  return routes;
}

interface Props {
  province: string;
  city: string;
  category: ProviderCategory;
}

const { province, city, category } = Astro.props;

const providers = filterByLocation(publishedProviders(), { province, city, category });
const empty = providers.length === 0;
const latestReview = empty ? null : providers.map((p) => p.verifiedAt).sort().at(-1)!;

const categoryLabelText = categoryLabel(category);
const title = `${categoryLabelText} en ${city}, ${province}`;
const description = empty
  ? `El directorio todavía no tiene fichas publicadas para esta ubicación y rubro.`
  : `${categoryLabelText} en ${city}, ${province}, con datos tomados de sus sitios oficiales.`;

const path = directoryProvinceCityRubroPath(province, city, category);
const pageUrl = absoluteUrl(path);
const indexable = isIndexable(providers.length);

const crumbs = site.origin && !empty
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'Directorio', item: absoluteUrl('/directorio/') },
        { '@type': 'ListItem', position: 3, name: province, item: absoluteUrl(directoryProvincePath(province)) },
        { '@type': 'ListItem', position: 4, name: city, item: absoluteUrl(directoryProvinceCityPath(province, city)) },
        { '@type': 'ListItem', position: 5, name: categoryLabelText, item: pageUrl },
      ],
    }
  : null;

const itemList = site.origin && !empty && indexable
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: providers.slice(0, 10).map((provider, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: provider.name,
        url: absoluteUrl(`/proveedor/${provider.slug}/`),
      })),
    }
  : null;
---

<Base title={title} description={description} path={path} noindex={!indexable || !site.allowIndexing}>
  {crumbs && <JsonLd slot="head" data={crumbs} />}
  {itemList && <JsonLd slot="head" data={itemList} />}
  
  <div class="container directory-page">
    <DirectoryPage 
      providers={providers} 
      title={categoryLabelText}
      description={`${providers.length} ${providers.length === 1 ? 'opción' : 'opciones'} en ${city}.`}
      kicker={`Directorio · ${province} · ${city}`}
      latestReview={latestReview!}
      showMethodology={true}
      province={province}
      city={city}
      category={category}
    />
  </div>
</Base>
