---
interface Props {
  name: 'cake' | 'drinks' | 'bag' | 'list' | 'receipt' | 'hero' | 'lost';
  class?: string;
}
const { name, class: className } = Astro.props;
---

{name === 'cake' && (
  <svg class={className} viewBox="0 0 160 120" fill="none" aria-hidden="true">
    <!-- Calculator illustration - clean and minimal -->
    <rect x="42" y="30" width="76" height="62" rx="8" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
    <rect x="54" y="42" width="24" height="10" rx="2" fill="#EDF7EA"/>
    <rect x="86" y="42" width="20" height="10" rx="2" fill="#EDF7EA"/>
    <rect x="54" y="60" width="52" height="4" rx="2" fill="#237A32"/>
    <rect x="54" y="70" width="52" height="4" rx="2" fill="#DCE3E8"/>
    <rect x="54" y="78" width="52" height="4" rx="2" fill="#DCE3E8"/>
    <circle cx="30" cy="38" r="6" fill="#FFCC33" opacity="0.8"/>
    <circle cx="132" cy="45" r="4" fill="#237A32" opacity="0.6"/>
  </svg>
)}

{name === 'drinks' && (
  <svg class={className} viewBox="0 0 160 120" fill="none" aria-hidden="true">
    <!-- Drinks illustration - bottle and glass -->
    <rect x="40" y="32" width="24" height="58" rx="10" fill="#237A32"/>
    <rect x="46" y="24" width="12" height="10" rx="3" fill="#195D26"/>
    <ellipse cx="52" cy="50" rx="8" ry="4" fill="#2A9742" opacity="0.5"/>
    <path d="M82 50 L92 50 L98 88 L76 88 Z" fill="#FFFFFF" stroke="#237A32" stroke-width="2.5"/>
    <path d="M82 50 L92 50 L90 62 L84 62 Z" fill="#EDF7EA"/>
    <circle cx="110" cy="36" r="5" fill="#FFCC33" opacity="0.7"/>
    <circle cx="32" cy="28" r="4" fill="#FFF0E8"/>
  </svg>
)}

{name === 'bag' && (
  <svg class={className} viewBox="0 0 160 120" fill="none" aria-hidden="true">
    <!-- Shopping bag illustration -->
    <path d="M46 44 L114 44 L108 94 L52 94 Z" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
    <path d="M58 44 L102 44 L100 58 L60 58 Z" fill="#EDF7EA"/>
    <path d="M64 44 C64 32 96 32 96 44" stroke="#237A32" stroke-width="3" stroke-linecap="round" fill="none"/>
    <rect x="68" y="66" width="24" height="3" rx="1.5" fill="#237A32" opacity="0.5"/>
    <rect x="68" y="74" width="18" height="3" rx="1.5" fill="#237A32" opacity="0.5"/>
    <circle cx="34" cy="32" r="5" fill="#FFCC33" opacity="0.7"/>
  </svg>
)}

{name === 'list' && (
  <svg class={className} viewBox="0 0 160 120" fill="none" aria-hidden="true">
    <!-- Checklist illustration -->
    <rect x="44" y="24" width="72" height="76" rx="8" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
    <circle cx="58" cy="44" r="4" fill="#EDF7EA" stroke="#237A32" stroke-width="2"/>
    <path d="M56 44 L57.5 45.5 L60 42.5" stroke="#237A32" stroke-width="1.5" stroke-linecap="round" fill="none"/>
    <rect x="68" y="42" width="32" height="3" rx="1.5" fill="#237A32"/>
    <circle cx="58" cy="62" r="4" fill="#EDF7EA" stroke="#237A32" stroke-width="2"/>
    <path d="M56 62 L57.5 63.5 L60 60.5" stroke="#237A32" stroke-width="1.5" stroke-linecap="round" fill="none"/>
    <rect x="68" y="60" width="28" height="3" rx="1.5" fill="#237A32"/>
    <circle cx="58" cy="80" r="4" fill="#FFFFFF" stroke="#237A32" stroke-width="2"/>
    <rect x="68" y="78" width="30" height="3" rx="1.5" fill="#DCE3E8"/>
    <circle cx="122" cy="30" r="5" fill="#FFCC33" opacity="0.7"/>
  </svg>
)}

{name === 'receipt' && (
  <svg class={className} viewBox="0 0 160 120" fill="none" aria-hidden="true">
    <!-- Budget receipt illustration -->
    <path d="M48 20 L112 20 L112 102 L106 97 L100 102 L94 97 L88 102 L82 97 L76 102 L70 97 L64 102 L58 97 L52 102 L48 98 Z" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
    <rect x="60" y="36" width="40" height="4" rx="2" fill="#237A32"/>
    <rect x="60" y="48" width="34" height="3" rx="1.5" fill="#DCE3E8"/>
    <rect x="60" y="56" width="38" height="3" rx="1.5" fill="#DCE3E8"/>
    <rect x="60" y="64" width="32" height="3" rx="1.5" fill="#DCE3E8"/>
    <rect x="60" y="78" width="40" height="4" rx="2" fill="#237A32"/>
    <circle cx="34" cy="32" r="5" fill="#FFCC33" opacity="0.7"/>
  </svg>
)}

{name === 'lost' && (
  <svg class={className} viewBox="0 0 220 160" fill="none" aria-hidden="true">
    <!-- Empty state illustration -->
    <circle cx="110" cy="80" r="46" fill="#EDF7EA"/>
    <ellipse cx="110" cy="72" rx="32" ry="36" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
    <circle cx="96" cy="68" r="4" fill="#237A32"/>
    <circle cx="124" cy="68" r="4" fill="#237A32"/>
    <path d="M92 84 C100 90 120 90 128 84" stroke="#237A32" stroke-width="3" stroke-linecap="round" fill="none"/>
    <path d="M82 58 C88 52 92 52 96 58" stroke="#237A32" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <path d="M124 58 C128 52 132 52 138 58" stroke="#237A32" stroke-width="2.5" stroke-linecap="round" fill="none"/>
    <circle cx="152" cy="44" r="6" fill="#FFCC33" opacity="0.7"/>
    <circle cx="64" cy="48" r="4" fill="#FFF0E8"/>
  </svg>
)}

{name === 'hero' && (
  <svg class={className} viewBox="0 0 560 460" fill="none" aria-hidden="true">
    <!-- Home hero - party planning illustration -->
    <circle cx="300" cy="230" r="180" fill="#EDF7EA"/>
    
    <!-- Calendar/planner -->
    <g transform="translate(80, 140)">
      <rect width="140" height="180" rx="12" fill="#FFFFFF" stroke="#237A32" stroke-width="4"/>
      <rect x="16" y="20" width="108" height="28" rx="6" fill="#237A32"/>
      <rect x="28" y="28" width="20" height="12" rx="3" fill="#FFFDF7"/>
      <circle cx="32" cy="70" r="5" fill="#EDF7EA" stroke="#237A32" stroke-width="2"/>
      <path d="M30 70 L31.5 71.5 L34 68.5" stroke="#237A32" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      <rect x="44" y="68" width="68" height="4" rx="2" fill="#237A32"/>
      <circle cx="32" cy="92" r="5" fill="#EDF7EA" stroke="#237A32" stroke-width="2"/>
      <path d="M30 92 L31.5 93.5 L34 90.5" stroke="#237A32" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      <rect x="44" y="90" width="56" height="4" rx="2" fill="#237A32"/>
      <circle cx="32" cy="114" r="5" fill="#FFFFFF" stroke="#237A32" stroke-width="2"/>
      <rect x="44" y="112" width="64" height="4" rx="2" fill="#DCE3E8"/>
      <circle cx="32" cy="136" r="5" fill="#FFFFFF" stroke="#237A32" stroke-width="2"/>
      <rect x="44" y="134" width="60" height="4" rx="2" fill="#DCE3E8"/>
    </g>
    
    <!-- Party items -->
    <g transform="translate(320, 160)">
      <!-- Drink bottle -->
      <rect x="10" y="30" width="28" height="70" rx="12" fill="#237A32"/>
      <rect x="16" y="20" width="16" height="14" rx="4" fill="#195D26"/>
      <ellipse cx="24" cy="52" rx="10" ry="5" fill="#2A9742" opacity="0.6"/>
      
      <!-- Shopping bag -->
      <path d="M52 50 L106 50 L100 120 L58 120 Z" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
      <path d="M62 50 L96 50 L94 68 L64 68 Z" fill="#EDF7EA"/>
      <path d="M70 50 C70 40 88 40 88 50" stroke="#237A32" stroke-width="3" stroke-linecap="round" fill="none"/>
    </g>
    
    <!-- Budget receipt -->
    <g transform="translate(360, 260)">
      <path d="M0 0 L56 0 L56 76 L51 71 L46 76 L41 71 L36 76 L31 71 L26 76 L21 71 L16 76 L11 71 L6 76 L0 70 Z" fill="#FFFFFF" stroke="#237A32" stroke-width="3"/>
      <rect x="10" y="14" width="36" height="4" rx="2" fill="#237A32"/>
      <rect x="10" y="26" width="28" height="3" rx="1.5" fill="#DCE3E8"/>
      <rect x="10" y="34" width="32" height="3" rx="1.5" fill="#DCE3E8"/>
      <rect x="10" y="42" width="26" height="3" rx="1.5" fill="#DCE3E8"/>
      <rect x="10" y="54" width="36" height="4" rx="2" fill="#237A32"/>
    </g>
    
    <!-- Decorative elements -->
    <circle cx="110" cy="120" r="8" fill="#FFCC33" opacity="0.7"/>
    <circle cx="470" cy="140" r="7" fill="#FFF0E8"/>
    <circle cx="260" cy="100" r="6" fill="#237A32" opacity="0.4"/>
    <circle cx="440" cy="310" r="8" fill="#EDF7EA"/>
  </svg>
)}
